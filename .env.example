# Supabase project URL and SERVICE ROLE key (Project Settings -> API).
# The service role key never leaves your machine; it lets the worker update jobs
# and lets the API publish its public URL for the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Optional: use a fixed public URL (named Cloudflare tunnel, hosted server, ...)
# instead of the automatic quick tunnel.
# PUBLIC_API_URL=https://ml.example.com
