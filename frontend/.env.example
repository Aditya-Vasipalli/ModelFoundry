# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# That's it. The ML backend publishes its own (tunnel) URL to Supabase and the
# app finds it automatically — no API URL to configure or redeploy.

# Optional: talk to a backend at a fixed URL instead, e.g. while developing.
# ML_API_URL=http://localhost:8000
